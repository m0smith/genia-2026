# run `python tools/gen_mcp_language_profile.py` and commit the result.

LANGUAGE_CONTROL_FLOW = {
  conditionals: "pattern_matching",
  if_expression: false,
  loops: false,
  recursion: true,
  tail_call_optimization: true
}

LANGUAGE_SUPPORTED_FORMS = ["function_definition", "function_call", "binary_expression", "literal", "variable", "pattern_dispatch", "case_expression", "open_function_clauses", "pipeline"]

LANGUAGE_PATTERNS = {
  function_argument_patterns: true,
  guard_patterns: true,
  list_patterns: true,
  literal_patterns: true,
  map_patterns: true,
  ordered_resolution: "first_match",
  tuple_patterns: true,
  wildcard_patterns: true
}

LANGUAGE_ABSENT_FORMS = ["if_expression", "while_loop", "for_loop"]

LANGUAGE_IDIOMS = {
  branching: "Use pattern-matched function clauses or case expressions.",
  clauses: "Several clauses of one function, such as a literal base case followed by a general case, need the first clause declared with open.",
  repetition: "Use recursion; tail-recursive calls are optimized in tail position.",
  pipelines: "Build data pipelines with |>: lines makes a Flow, map transforms, keep_some keeps only some results, and some, none, and err Outcomes carry validation; callers define the parse and validate functions."
}

