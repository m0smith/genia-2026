# mcp.genia -- native Genia MCP server (R28 E28-1, issue #702).
#
# Application entry for the Genia MCP server over local stdio. Two protocol
# eras are served (contract amendment A5, closed policy, nothing else): MCP
# 2026-07-28 (stateless; per-request _meta; no session) and MCP 2025-11-25
# (selected by `initialize`; one process-local state bit). This program owns
# decode, validation, era selection, dispatch, result construction, JSON
# encoding/framing, and stdout production. Both eras reach the same tool
# definitions and implementations. The build/launch contract_revision is passed
# as the single program argument; hosted launch explicitly supplies parse/run
# callbacks through the host capability map. See
# docs/design/r28-genia-mcp-contract-threat-model.md (sections 2, 7.1, 14, 18)
# and docs/design/r28-e28-1-native-mcp-skeleton-design.md.
#
# Surface: genia_capabilities always; genia_parse (E28-2) only when the host
# provisions the `parse` capability as an explicit argument to serve(revision, host)
# (docs/design/r28-e28-2-parse-tool-design.md). Plain file mode calls serve(rev, {}),
# so it advertises genia_capabilities and the native-only genia_language_profile
# (amendment A6, section 19 of the contract). Hosted launch advertises genia_run
# only when its run callback is provisioned.

@doc "Match and unwrap one json representation layer."
pattern Json(value) = representation_match("json", value)

# ---- closed JSON type checks (Genia Templates compiled from json_schema) ----

@doc "Compile a decoded schema Outcome, or return schema-unavailable."
schema_template(o) =
  some(sch, _) -> json_schema(sch) |
  _ -> err("schema-unavailable", {})

@doc "Decode and compile schema text; substitute a schema-unavailable absence on failure."
template(text) =
  unwrap_or((_) -> none("schema-unavailable"), schema_template(json_decode(text)))

StringT = template("{\"type\":\"string\"}")
IntegerT = template("{\"type\":\"integer\"}")
ObjectT = template("{\"type\":\"object\"}")

@doc "Return true only for a successful single-value Outcome."
accepted(o) = some(_) -> true | _ -> false

@doc "Test a value against the compiled JSON string Template."
is_string(v) = accepted(StringT(v))
@doc "Test a value against the compiled JSON integer Template."
is_integer(v) = accepted(IntegerT(v))
@doc "Test a value against the compiled JSON object Template."
is_object(v) = accepted(ObjectT(v))
@doc "Accept only string or integer request identifiers."
is_id(v) = is_string(v) || is_integer(v)

# ---- fixed protocol constants ----

PROTOCOL_VERSION = "2026-07-28"
COMPAT_PROTOCOL_VERSION = "2025-11-25"
META_VERSION = "io.modelcontextprotocol/protocolVersion"
META_CAPABILITIES = "io.modelcontextprotocol/clientCapabilities"

# ---- JSON framing: one protocol line per message ----

# json_encode emits one member per line, indented two spaces per nesting level, and
# string values never contain a literal newline. Removing every "newline + indent"
# pattern from the deepest level (Genia's JSON nesting limit is 128 containers) up
# to the shallowest yields the same single line as trimming every line, in 129
# native passes instead of one call per line (which is quadratic on large values).
# The patterns are built once at load time.
SQUASH_DEEPEST = 128

@doc "Build newline-and-indent separators through the JSON container depth bound."
indent_patterns(k, cur, acc) =
  (n, c, a) ? n > SQUASH_DEEPEST -> a |
  (n, c, a) -> indent_patterns(n + 1, concat(c, "  "), append(a, [c]))

# Longest first, so a shorter pattern never cuts a longer one.
INDENT_PATTERNS = reverse(indent_patterns(0, "\n", []))

@doc "Remove JSON layout newlines and indentation without altering escaped string content."
squash(text) = reduce((t, sep) -> join("", split(t, sep)), text, INDENT_PATTERNS)

# Fixed placeholders for the genia_parse splice (a quoted JSON string in the encoding).
AST_SLOT_VALUE = "@@genia-ast-slot@@"
STRUCT_SLOT_VALUE = "@@genia-structured-slot@@"
AST_SLOT = concat(concat("\"", AST_SLOT_VALUE), "\"")
STRUCT_SLOT = concat(concat("\"", STRUCT_SLOT_VALUE), "\"")

INTERNAL_FRAME = "{\"error\": {\"code\": -32603,\"message\": \"Internal error\"},\"jsonrpc\": \"2.0\"}"

@doc "Convert encoded JSON success to one line; use a fixed internal-error frame on failure."
finish(o) =
  some(text, _) -> squash(text) |
  _ -> INTERNAL_FRAME

@doc "Encode a response map as one JSON protocol line."
frame(message) = finish(json_encode(message))

# ---- response construction ----

# idv is [] (id unreadable or absent) or [id]; Outcome values are avoided as
# data because none(...) propagates through ordinary calls.
@doc "Attach the singleton readable identifier, or leave the response without an id."
with_id(base, idv) =
  (b, [x]) -> map_put(b, "id", x) |
  (b, _) -> b

@doc "Construct the fixed JSON-RPC code and message object."
error_body(code, message) = {code: code, message: message}

@doc "Build a JSON-RPC error and preserve the readable request identifier."
error_response(c, code, message) =
  with_id(
    {jsonrpc: "2.0", error: error_body(code, message)},
    map_get(c, "idv"))

@doc "Build JSON-RPC Parse error with code -32700."
parse_error(c) = error_response(c, -32700, "Parse error")
@doc "Build JSON-RPC Invalid request with code -32600."
invalid_request(c) = error_response(c, -32600, "Invalid request")
@doc "Build JSON-RPC Method not found with code -32601."
method_not_found(c) = error_response(c, -32601, "Method not found")
@doc "Build JSON-RPC Invalid params with code -32602."
invalid_params(c) = error_response(c, -32602, "Invalid params")
@doc "Build JSON-RPC Internal error with code -32603."
internal_error(c) = error_response(c, -32603, "Internal error")

@doc "Report unsupported modern protocol version and the supported version list."
version_error(c, requested) =
  with_id(
    {jsonrpc: "2.0",
     error: {code: -32022,
             message: "Unsupported protocol version",
             data: {supported: [PROTOCOL_VERSION], requested: requested}}},
    map_get(c, "idv"))

@doc "Return Invalid params with the fixed Unknown tool message."
unknown_tool_response(c) =
  with_id(
    {jsonrpc: "2.0", error: error_body(-32602, "Unknown tool")},
    map_get(c, "idv"))

@doc "Build a JSON-RPC success with the selected protocol-era result shape."
result_response(c, result) =
  with_id({jsonrpc: "2.0", result: era_shaped(c, result)}, map_get(c, "idv"))

# The 2025-11-25 wire shape omits the 2026-07-28-only members (contract A5.5).
@doc "Keep modern result fields or remove compatibility-inapplicable fields."
era_shaped(c, result) =
  (k, r) ? modern_request(k) -> r |
  (_, r) -> compat_shape(r)

@doc "Remove resultType, ttlMs, cacheScope and metadata for compatibility clients."
compat_shape(r) =
  map_remove(map_remove(map_remove(map_remove(r, "resultType"), "ttlMs"), "cacheScope"), "_meta")

@doc "Return the fixed server name and launch revision as its version."
server_info(c) = {"name": "genia-mcp", "version": map_get(c, "rev")}

@doc "Wrap server identity in modern result metadata."
result_meta(c) = {"io.modelcontextprotocol/serverInfo": server_info(c)}

# ---- capability values ----

SOURCE_MAX_BYTES = 262144
RESULT_MAX_BYTES = 3276800

# The host map holds provisioned capabilities; a tool is advertised only if the host
# provisioned what it needs (parse -> genia_parse, run -> genia_run).
@doc "Test whether the explicit host map provisions the parse capability."
parse_enabled(c) = map_has?(map_get(c, "host"), "parse")
@doc "Test whether the explicit host map provisions the run capability."
run_enabled(c) = map_has?(map_get(c, "host"), "run")

@doc "Decide whether the named tool is available under the explicit host map."
advertised(c, name) =
  (k, "genia_capabilities") -> true |
  (k, "genia_parse") -> parse_enabled(k) |
  (k, "genia_run") -> run_enabled(k) |
  (k, "genia_language_profile") -> true |
  (_, _) -> false

@doc "Return advertised tool names in contract descriptor order."
tool_names(c) = tool_descriptors(c) |> map((t) -> field(t, "name"))

@doc "Fixed source-only worker limits and unavailable capabilities; defense in depth, not a security sandbox."
EXECUTION_PROFILE = {
  name: "source-only-isolated-v1",
  source_max_bytes: 262144,
  timeout_ms: 5000,
  stdout_max_bytes: 1048576,
  stderr_max_bytes: 1048576,
  value_max_bytes: 1048576,
  diagnostic_max_bytes: 65536,
  filesystem: false,
  environment: false,
  configuration: false,
  secrets: false,
  network: false
}

@doc "Describe the active protocol era, host, revision, tool names and fixed execution profile."
capabilities_value(c) = {
  server: {name: "genia-mcp", contract: "genia.mcp.v1"},
  mcp: {protocol_version: serving_version(c), transport: "stdio"},
  genia: {host: "python-reference",
          contract_revision: map_get(c, "rev"),
          portable_mcp_implementation: false},
  tools: tool_names(c),
  execution_profile: EXECUTION_PROFILE
}

@doc "Wrap capability discovery in the genia.mcp.v1 success envelope."
capabilities_envelope(c) = {
  schema_version: "genia.mcp.v1",
  status: "ok",
  result: capabilities_value(c),
  error: nil
}

@doc "Argument-free capability discovery schema and assistant-facing description."
tool_descriptor = {
  name: "genia_capabilities",
  description: "Report the Genia MCP server identity, protocol revision, transport, advertised tools, and governed execution profile.",
  inputSchema: {type: "object", additionalProperties: false, properties: {}}
}

@doc "Closed source-only parse-tool schema; the native byte policy is authoritative."
parse_descriptor = {
  name: "genia_parse",
  description: "Parse explicit Genia source text and return the existing normalized parse output, or a bounded parse diagnostic. Parsing never evaluates the source.",
  inputSchema: {type: "object", additionalProperties: false, required: ["source"],
                properties: {source: {type: "string", maxLength: 262144}}}
}

@doc "Closed source-only execution-tool schema and explicit authority restrictions."
run_descriptor = {
  name: "genia_run",
  description: "Run explicit Genia source in a fresh, disposable, policy-restricted worker. Returns the canonical debug rendering of the value, program stdout, and program stderr as separate fields, or a bounded failure. Source only: no file, environment, configuration, secret, network, process, or import authority.",
  inputSchema: {type: "object", additionalProperties: false, required: ["source"],
                properties: {source: {type: "string", maxLength: 262144}}}
}

@doc "Argument-free static language-profile schema and assistant-facing purpose."
profile_descriptor = {
  name: "genia_language_profile",
  description: "Describe Genia's language model for assistants before they write source: branching is pattern matching, there is no if-expression or loop, repetition is recursion, with canonical examples. Takes no arguments; returns a fixed, deterministic description.",
  inputSchema: {type: "object", additionalProperties: false, properties: {}}
}

# Contract order: genia_capabilities, genia_parse, genia_run, genia_language_profile
# (only those provisioned; the profile needs no host capability).
@doc "Filter the fixed descriptor list by provisioned host capabilities."
tool_descriptors(c) =
  [tool_descriptor, parse_descriptor, run_descriptor, profile_descriptor] |> filter((t) -> advertised(c, field(t, "name")))

@doc "Construct stateless modern discovery with zero TTL and public cache scope."
discover_result(c) = {
  resultType: "complete",
  supportedVersions: [PROTOCOL_VERSION],
  capabilities: {tools: {}},
  ttlMs: 0,
  cacheScope: "public",
  "_meta": result_meta(c)
}

@doc "Construct the modern tool list with identity metadata and zero TTL."
list_result(c) = {
  resultType: "complete",
  tools: tool_descriptors(c),
  ttlMs: 0,
  cacheScope: "public",
  "_meta": result_meta(c)
}

# Tool-result construction shared by every tool: the envelope is both the
# structuredContent and (single-line encoded) the sole text content item. An
# envelope whose encoding exceeds the aggregate result limit is replaced by a
# fixed result_limit envelope (the oversized content is discarded).
@doc "Encode an envelope and apply the aggregate result-size policy."
tool_result(c, envelope) = bounded_result(c, envelope, json_encode(envelope))

@doc """
Reject oversized encoded content, finish a valid result, or return internal error.

## Arguments
`c`: context. `envelope`: tool envelope. `encoded`: JSON encode Outcome.

## Returns
Finished result if encoded content meets the aggregate limit; fixed result-limit response above it; JSON-RPC internal error on encoding failure.
"""
bounded_result(c, envelope, encoded) =
  (k, e, some(text, _)) ? byte_length(squash(text)) > RESULT_MAX_BYTES -> limited_result(k) |
  (k, e, some(text, _)) -> finished_result(k, e, squash(text)) |
  (k, _, _) -> internal_error(k)

@doc "Put the same envelope in structuredContent and the sole encoded text item."
finished_result(c, envelope, text) = {
  resultType: "complete",
  content: [{type: "text", text: text}],
  structuredContent: envelope,
  isError: envelope_is_error(envelope),
  "_meta": result_meta(c)
}

@doc "Test whether the envelope status is error."
envelope_is_error(envelope) = field(envelope, "status") == "error"

@doc "Return the fixed aggregate result-limit envelope."
limited_result(c) =
  finish_limited(c, error_envelope("result_limit", "adapter", "Result exceeds the 3276800-byte limit"))

@doc "Finish an already bounded limit envelope without recursively checking its size."
finish_limited(c, envelope) = finished_result(c, envelope, squash(unwrap_or("", json_encode(envelope))))

@doc "Construct a closed schema-versioned tool failure envelope."
error_envelope(kind, phase, message) = {
  schema_version: "genia.mcp.v1",
  status: "error",
  result: nil,
  error: {kind: kind, message: message, phase: phase}
}

@doc "Build the capability tool result with aggregate size enforcement."
call_result(c) = tool_result(c, capabilities_envelope(c))

# ---- genia_language_profile (amendment A6) ----
#
# A fixed description of Genia's control-flow model for assistants. It is MCP adapter
# text, not language behavior: GENIA_STATE.md governs, and tests evaluate every example
# directly. The only varying datum is the launch contract_revision.

@doc "Canonical GCD and factorial source examples verified by existing profile tests."
LANGUAGE_EXAMPLES = {
  gcd: "open gcd(a, 0) = a\ngcd(a, b) = gcd(b, a % b)\ngcd(48, 18)",
  factorial: "open fact(0) = 1\nfact(n) = n * fact(n - 1)\nfact(5)"
}

# >>> BEGIN GENERATED: mcp_language_profile (docs/contract/semantic_facts.json) >>>
