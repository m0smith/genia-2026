# mcp.genia -- native Genia MCP server (R28 E28-1, issue #702).
#
# Application entry for the Genia MCP server over local stdio. Two protocol
# eras are served (contract amendment A5, closed policy, nothing else): MCP
# 2026-07-28 (stateless; per-request _meta; no session) and MCP 2025-11-25
# (selected by `initialize`; one process-local state bit). This program owns
# decode, validation, era selection, dispatch, result construction, JSON
# encoding/framing, and stdout production. Both eras reach the same tool
# definitions and implementations. The only host-supplied datum is the
# build/launch `contract_revision`, passed as the single program argument. See
# docs/design/r28-genia-mcp-contract-threat-model.md (sections 2, 7.1, 14, 18)
# and docs/design/r28-e28-1-native-mcp-skeleton-design.md.
#
# Surface: genia_capabilities always; genia_parse (E28-2) only when the host
# provisions the `parse` capability as an explicit argument to serve(revision, host)
# (docs/design/r28-e28-2-parse-tool-design.md). Plain file mode calls serve(rev, {}),
# so it advertises genia_capabilities and the native-only genia_language_profile
# (amendment A6, section 19 of the contract). The execution tool belongs to E28-3.

pattern Json(value) = representation_match("json", value)

# ---- closed JSON type checks (Genia Templates compiled from json_schema) ----

schema_template(o) =
  some(sch, _) -> json_schema(sch) |
  _ -> err("schema-unavailable", {})

template(text) =
  unwrap_or((_) -> none("schema-unavailable"), schema_template(json_decode(text)))

StringT = template("{\"type\":\"string\"}")
IntegerT = template("{\"type\":\"integer\"}")
ObjectT = template("{\"type\":\"object\"}")

accepted(o) = some(_) -> true | _ -> false

is_string(v) = accepted(StringT(v))
is_integer(v) = accepted(IntegerT(v))
is_object(v) = accepted(ObjectT(v))
is_id(v) = is_string(v) || is_integer(v)

# ---- fixed protocol constants ----

PROTOCOL_VERSION = "2026-07-28"
COMPAT_PROTOCOL_VERSION = "2025-11-25"
META_VERSION = "io.modelcontextprotocol/protocolVersion"
META_CAPABILITIES = "io.modelcontextprotocol/clientCapabilities"

# ---- JSON framing: one protocol line per message ----

# json_encode emits one member per line, indented two spaces per nesting level, and
# string values never contain a literal newline. Removing every "newline + indent"
# pattern from the deepest level (Genia's JSON nesting limit is 128 containers) up
# to the shallowest yields the same single line as trimming every line, in 129
# native passes instead of one call per line (which is quadratic on large values).
# The patterns are built once at load time.
SQUASH_DEEPEST = 128

indent_patterns(k, cur, acc) =
  (n, c, a) ? n > SQUASH_DEEPEST -> a |
  (n, c, a) -> indent_patterns(n + 1, concat(c, "  "), append(a, [c]))

# Longest first, so a shorter pattern never cuts a longer one.
INDENT_PATTERNS = reverse(indent_patterns(0, "\n", []))

squash(text) = reduce((t, sep) -> join("", split(t, sep)), text, INDENT_PATTERNS)

# Fixed placeholders for the genia_parse splice (a quoted JSON string in the encoding).
AST_SLOT_VALUE = "@@genia-ast-slot@@"
STRUCT_SLOT_VALUE = "@@genia-structured-slot@@"
AST_SLOT = concat(concat("\"", AST_SLOT_VALUE), "\"")
STRUCT_SLOT = concat(concat("\"", STRUCT_SLOT_VALUE), "\"")

INTERNAL_FRAME = "{\"error\": {\"code\": -32603,\"message\": \"Internal error\"},\"jsonrpc\": \"2.0\"}"

finish(o) =
  some(text, _) -> squash(text) |
  _ -> INTERNAL_FRAME

frame(message) = finish(json_encode(message))

# ---- response construction ----

# idv is [] (id unreadable or absent) or [id]; Outcome values are avoided as
# data because none(...) propagates through ordinary calls.
with_id(base, idv) =
  (b, [x]) -> map_put(b, "id", x) |
  (b, _) -> b

error_body(code, message) = {code: code, message: message}

error_response(c, code, message) =
  with_id(
    {jsonrpc: "2.0", error: error_body(code, message)},
    map_get(c, "idv"))

parse_error(c) = error_response(c, -32700, "Parse error")
invalid_request(c) = error_response(c, -32600, "Invalid request")
method_not_found(c) = error_response(c, -32601, "Method not found")
invalid_params(c) = error_response(c, -32602, "Invalid params")
internal_error(c) = error_response(c, -32603, "Internal error")

version_error(c, requested) =
  with_id(
    {jsonrpc: "2.0",
     error: {code: -32022,
             message: "Unsupported protocol version",
             data: {supported: [PROTOCOL_VERSION], requested: requested}}},
    map_get(c, "idv"))

unknown_tool_response(c) =
  with_id(
    {jsonrpc: "2.0", error: error_body(-32602, "Unknown tool")},
    map_get(c, "idv"))

result_response(c, result) =
  with_id({jsonrpc: "2.0", result: era_shaped(c, result)}, map_get(c, "idv"))

# The 2025-11-25 wire shape omits the 2026-07-28-only members (contract A5.5).
era_shaped(c, result) =
  (k, r) ? modern_request(k) -> r |
  (_, r) -> compat_shape(r)

compat_shape(r) =
  map_remove(map_remove(map_remove(map_remove(r, "resultType"), "ttlMs"), "cacheScope"), "_meta")

server_info(c) = {"name": "genia-mcp", "version": map_get(c, "rev")}

result_meta(c) = {"io.modelcontextprotocol/serverInfo": server_info(c)}

# ---- capability values ----

SOURCE_MAX_BYTES = 262144
RESULT_MAX_BYTES = 3276800

# The host map holds provisioned capabilities; a tool is advertised only if the host
# provisioned what it needs (parse -> genia_parse, run -> genia_run).
parse_enabled(c) = map_has?(map_get(c, "host"), "parse")
run_enabled(c) = map_has?(map_get(c, "host"), "run")

advertised(c, name) =
  (k, "genia_capabilities") -> true |
  (k, "genia_parse") -> parse_enabled(k) |
  (k, "genia_run") -> run_enabled(k) |
  (k, "genia_language_profile") -> true |
  (_, _) -> false

tool_names(c) = tool_descriptors(c) |> map((t) -> field(t, "name"))

EXECUTION_PROFILE = {
  name: "source-only-isolated-v1",
  source_max_bytes: 262144,
  timeout_ms: 5000,
  stdout_max_bytes: 1048576,
  stderr_max_bytes: 1048576,
  value_max_bytes: 1048576,
  diagnostic_max_bytes: 65536,
  filesystem: false,
  environment: false,
  configuration: false,
  secrets: false,
  network: false
}

capabilities_value(c) = {
  server: {name: "genia-mcp", contract: "genia.mcp.v1"},
  mcp: {protocol_version: serving_version(c), transport: "stdio"},
  genia: {host: "python-reference",
          contract_revision: map_get(c, "rev"),
          portable_mcp_implementation: false},
  tools: tool_names(c),
  execution_profile: EXECUTION_PROFILE
}

capabilities_envelope(c) = {
  schema_version: "genia.mcp.v1",
  status: "ok",
  result: capabilities_value(c),
  error: nil
}

tool_descriptor = {
  name: "genia_capabilities",
  description: "Report the Genia MCP server identity, protocol revision, transport, advertised tools, and governed execution profile.",
  inputSchema: {type: "object", additionalProperties: false, properties: {}}
}

parse_descriptor = {
  name: "genia_parse",
  description: "Parse explicit Genia source text and return the existing normalized parse output, or a bounded parse diagnostic. Parsing never evaluates the source.",
  inputSchema: {type: "object", additionalProperties: false, required: ["source"],
                properties: {source: {type: "string", maxLength: 262144}}}
}

run_descriptor = {
  name: "genia_run",
  description: "Run explicit Genia source in a fresh, disposable, policy-restricted worker. Returns the canonical debug rendering of the value, program stdout, and program stderr as separate fields, or a bounded failure. Source only: no file, environment, configuration, secret, network, process, or import authority.",
  inputSchema: {type: "object", additionalProperties: false, required: ["source"],
                properties: {source: {type: "string", maxLength: 262144}}}
}

profile_descriptor = {
  name: "genia_language_profile",
  description: "Describe Genia's language model for assistants before they write source: branching is pattern matching, there is no if-expression or loop, repetition is recursion, with canonical examples. Takes no arguments; returns a fixed, deterministic description.",
  inputSchema: {type: "object", additionalProperties: false, properties: {}}
}

# Contract order: genia_capabilities, genia_parse, genia_run, genia_language_profile
# (only those provisioned; the profile needs no host capability).
tool_descriptors(c) =
  [tool_descriptor, parse_descriptor, run_descriptor, profile_descriptor] |> filter((t) -> advertised(c, field(t, "name")))

discover_result(c) = {
  resultType: "complete",
  supportedVersions: [PROTOCOL_VERSION],
  capabilities: {tools: {}},
  ttlMs: 0,
  cacheScope: "public",
  "_meta": result_meta(c)
}

list_result(c) = {
  resultType: "complete",
  tools: tool_descriptors(c),
  ttlMs: 0,
  cacheScope: "public",
  "_meta": result_meta(c)
}

# Tool-result construction shared by every tool: the envelope is both the
# structuredContent and (single-line encoded) the sole text content item. An
# envelope whose encoding exceeds the aggregate result limit is replaced by a
# fixed result_limit envelope (the oversized content is discarded).
tool_result(c, envelope) = bounded_result(c, envelope, json_encode(envelope))

bounded_result(c, envelope, encoded) =
  (k, e, some(text, _)) ? byte_length(squash(text)) > RESULT_MAX_BYTES -> limited_result(k) |
  (k, e, some(text, _)) -> finished_result(k, e, squash(text)) |
  (k, _, _) -> internal_error(k)

finished_result(c, envelope, text) = {
  resultType: "complete",
  content: [{type: "text", text: text}],
  structuredContent: envelope,
  isError: envelope_is_error(envelope),
  "_meta": result_meta(c)
}

envelope_is_error(envelope) = field(envelope, "status") == "error"

limited_result(c) =
  finish_limited(c, error_envelope("result_limit", "adapter", "Result exceeds the 3276800-byte limit"))

finish_limited(c, envelope) = finished_result(c, envelope, squash(unwrap_or("", json_encode(envelope))))

error_envelope(kind, phase, message) = {
  schema_version: "genia.mcp.v1",
  status: "error",
  result: nil,
  error: {kind: kind, message: message, phase: phase}
}

call_result(c) = tool_result(c, capabilities_envelope(c))

# ---- genia_language_profile (amendment A6) ----
#
# A fixed description of Genia's control-flow model for assistants. It is MCP adapter
# text, not language behavior: GENIA_STATE.md governs, and tests evaluate every example
# directly. The only varying datum is the launch contract_revision.

LANGUAGE_CONTROL_FLOW = {
  conditionals: "pattern_matching",
  if_expression: false,
  loops: false,
  recursion: true,
  tail_call_optimization: true
}

LANGUAGE_SUPPORTED_FORMS = [
  "function_definition",
  "function_call",
  "binary_expression",
  "literal",
  "variable",
  "pattern_dispatch",
  "case_expression",
  "open_function_clauses",
  "pipeline"
]

LANGUAGE_PATTERNS = {
  function_argument_patterns: true,
  literal_patterns: true,
  wildcard_patterns: true,
  tuple_patterns: true,
  list_patterns: true,
  map_patterns: true,
  guard_patterns: true,
  ordered_resolution: "first_match"
}

LANGUAGE_ABSENT_FORMS = ["if_expression", "while_loop", "for_loop"]

LANGUAGE_IDIOMS = {
  branching: "Use pattern-matched function clauses or case expressions.",
  repetition: "Use recursion; tail-recursive calls are optimized in tail position.",
  clauses: "Several clauses of one function, such as a literal base case followed by a general case, need the first clause declared with open."
}

LANGUAGE_EXAMPLES = {
  gcd: "open gcd(a, 0) = a\ngcd(a, b) = gcd(b, a % b)\ngcd(48, 18)",
  factorial: "open fact(0) = 1\nfact(n) = n * fact(n - 1)\nfact(5)"
}

# A7: static, curated STATE facts; nil encodes as JSON null. No live discovery.
LANGUAGE_DISCOVERY = {
  coverage: "curated_non_exhaustive",
  facts: [
    {id: "pattern_branching", scope: "language", status: "implemented",
     maturity: nil, summary: "Branching uses pattern matching.",
     state_sections: ["5"]},
    {id: "tail_calls", scope: "language", status: "implemented",
     maturity: nil, summary: "Tail calls are optimized.",
     state_sections: ["8"]},
    {id: "if_and_loops", scope: "language", status: "unsupported",
     maturity: nil, summary: "There is no dedicated if expression or while/for loop syntax.",
     state_sections: ["5", "9.50"]},
    {id: "flow_shared_coverage", scope: "shared_conformance", status: "partial",
     maturity: "Experimental", summary: "Flow runs in Python; shared executable coverage is limited to first-wave cases.",
     state_sections: ["0", "1"]},
    {id: "core_ir_stability", scope: "shared_conformance", status: "partial",
     maturity: "Partial", summary: "Portable Core IR stability remains Partial.",
     state_sections: ["0"]},
    {id: "cpp_language_floor", scope: "cpp_host", status: "partial",
     maturity: nil, summary: "C++ implements the bounded R27 production floor, not Python feature parity.",
     state_sections: ["0"]},
    {id: "other_language_hosts", scope: "other_hosts", status: "planned",
     maturity: nil, summary: "Node.js, Java, Rust, and Go hosts are planned, not implemented.",
     state_sections: ["0"]},
    {id: "browser_runtime", scope: "browser", status: "scaffolded",
     maturity: nil, summary: "Browser artifacts are documentation scaffolding; no runtime or playground is implemented.",
     state_sections: ["0.1"]},
    {id: "mcp_surface", scope: "mcp", status: "implemented",
     maturity: nil, summary: "Python-host local stdio MCP exposes four tools after A6.",
     state_sections: ["9.49", "9.50"]},
    {id: "cpp_mcp", scope: "mcp", status: "unsupported",
     maturity: nil, summary: "There is no C++ MCP implementation.",
     state_sections: ["9.49", "9.50"]},
    {id: "windows_mcp", scope: "mcp_windows", status: "unsupported",
     maturity: nil, summary: "Windows MCP deployment is unsupported.",
     state_sections: ["9.49"]},
    {id: "macos_hardening", scope: "mcp_macos", status: "partial",
     maturity: nil, summary: "macOS MCP runs are verified without an address-space bound or network namespace; the profile is not a security sandbox.",
     state_sections: ["9.48", "9.49"]}
  ]
}

language_value(c) = {
  name: "Genia",
  contract_revision: map_get(c, "rev"),
  control_flow: LANGUAGE_CONTROL_FLOW,
  supported_forms: LANGUAGE_SUPPORTED_FORMS,
  patterns: LANGUAGE_PATTERNS,
  absent_forms: LANGUAGE_ABSENT_FORMS,
  idioms: LANGUAGE_IDIOMS,
  examples: LANGUAGE_EXAMPLES,
  discovery: LANGUAGE_DISCOVERY
}

profile_envelope(c) = {
  schema_version: "genia.mcp.v1",
  status: "ok",
  result: {language: language_value(c)},
  error: nil
}

# ---- request validation (JSON-RPC shape and per-request _meta) ----

# Total accessors: `&&`/`||` do not short-circuit, so every check below is safe
# to evaluate on any JSON value. `field` yields nil for an absent key or a
# non-object, and nil satisfies none of the type checks.
# JSON null decodes to none("nil"), and none(...) short-circuits ordinary calls,
# so null and absent both normalize to [] (which fails every type check).
norm(v) =
  none(_) -> [] |
  none(_, _) -> [] |
  x -> x

field_present(m, key) =
  (y, j) ? map_has?(y, j) -> norm(map_get(y, j)) |
  (_, _) -> []

field(m, key) =
  (x, k) ? is_object(x) -> field_present(x, k) |
  (_, _) -> []

present(m, key) =
  (x, k) ? is_object(x) -> map_has?(x, k) |
  (_, _) -> false

empty_object(v) =
  x ? is_object(x) -> map_count(x) == 0 |
  _ -> false

header_valid(r) = field(r, "jsonrpc") == "2.0" && is_string(field(r, "method"))

msg_of(c) = map_get(c, "msg")

params_of(c) = field(msg_of(c), "params")

params_valid(c) = is_object(params_of(c))

meta_of(c) = field(params_of(c), "_meta")

meta_valid(c) = is_object(meta_of(c)) && is_string(field(meta_of(c), META_VERSION)) && is_object(field(meta_of(c), META_CAPABILITIES))

method_of(c) = field(msg_of(c), "method")

known_method(m) = m == "server/discover" || m == "tools/list" || m == "tools/call"

# ---- era selection (contract A5.2) ----
# A request whose params._meta carries the 2026-07-28 version key is a 2026-07-28
# request; every other request is a 2025-11-25 request. This is the only protocol
# decision the two eras do not share.
modern_request(c) = present(meta_of(c), META_VERSION)

serving_version(c) =
  k ? modern_request(k) -> PROTOCOL_VERSION |
  _ -> COMPAT_PROTOCOL_VERSION

# ---- dispatch ----

tool_name_valid(c) = is_string(field(params_of(c), "name"))

arguments_ok(c) = present(params_of(c), "arguments") == false || empty_object(field(params_of(c), "arguments"))

object_size(v) =
  x ? is_object(x) -> map_count(x) |
  _ -> -1

args_of(c) = field(params_of(c), "arguments")

# genia_parse and genia_run take exactly one string `source` (closed schema).
parse_arguments_ok(c) = object_size(args_of(c)) == 1 && is_string(field(args_of(c), "source"))

tool_of(c) = field(params_of(c), "name")

call_tool(c) =
  k ? tool_name_valid(k) == false -> invalid_params(k) |
  k ? tool_of(k) == "genia_capabilities" -> call_capabilities(k) |
  k ? tool_of(k) == "genia_parse" && parse_enabled(k) -> call_parse(k) |
  k ? tool_of(k) == "genia_run" && run_enabled(k) -> call_run(k) |
  k ? tool_of(k) == "genia_language_profile" -> call_language_profile(k) |
  k -> unknown_tool_response(k)

call_capabilities(c) =
  k ? arguments_ok(k) == false -> invalid_params(k) |
  k -> result_response(k, call_result(k))

call_language_profile(c) =
  k ? arguments_ok(k) == false -> invalid_params(k) |
  k -> result_response(k, tool_result(k, profile_envelope(k)))

call_parse(c) =
  k ? parse_arguments_ok(k) == false -> invalid_params(k) |
  k -> parse_response(k, parse_result(k, field(args_of(k), "source")))

# parse_result yields [result, structured]. `structured` is "" for an ordinary result.
# For a parsed AST it is the final single-line structuredContent text (see below), and
# the result carries a placeholder where that text goes.
parse_response(c, pair) =
  (k, [r, ""]) -> result_response(k, r) |
  (k, [r, s]) -> {genia_splice: [result_response(k, r), s]}

# genia_parse: size policy is native; only the parser itself is host-provided.
parse_result(c, source) =
  (k, src) ? byte_length(src) > SOURCE_MAX_BYTES -> parse_plain(k, error_envelope("input_limit", "protocol", "Genia source exceeds the 262144-byte limit")) |
  (k, src) -> parse_reply(k, split((map_get(map_get(k, "host"), "parse"))(src), "\n"))

parse_plain(c, envelope) = [tool_result(c, envelope), ""]

parse_internal() = error_envelope("internal_error", "adapter", "Internal error while parsing")

# H22 / contract Clarification A3: the AST is lossless opaque transport text. The host
# capability replies with a small JSON header, and for a parsed source a newline and
# the AST text. Only the header is decoded here (json_decode); the AST text is never
# decoded or re-encoded, so integers outside the R9 portable-JSON range (+/-(2^53-1))
# cross unchanged. This is a local string splice for genia_parse, not a Genia facility.
parse_reply(c, parts) =
  (k, [head, ast]) -> parse_parsed(k, json_decode(head), ast) |
  (k, [head]) -> parse_head(k, json_decode(head)) |
  (k, _) -> parse_plain(k, parse_internal())

parse_head(c, decoded) =
  (k, some(Json(r), _)) ? field(r, "status") == "syntax_error" -> parse_plain(k, syntax_error_envelope(field(r, "offset"))) |
  (k, _) -> parse_plain(k, parse_internal())

parsed_header_ok(r) = field(r, "status") == "parsed" && object_size(r) == 1

# The AST must be an object or array text.
fragment_ok(a) =
  (starts_with(a, "{") && ends_with(a, "}")) || (starts_with(a, "[") && ends_with(a, "]"))

parse_parsed(c, decoded, ast) =
  (k, some(Json(r), _), a) ? parsed_header_ok(r) && fragment_ok(a) -> parsed_slotted(k, a, split(squash(unwrap_or("", json_encode(parsed_envelope(AST_SLOT_VALUE)))), AST_SLOT)) |
  (k, _, _) -> parse_plain(k, parse_internal())

parsed_slotted(c, ast, parts) =
  (k, a, [before, after]) -> parsed_structured(k, join(a, [before, after])) |
  (k, _, _) -> parse_plain(k, parse_internal())

# The result limit is measured on the final single-line structuredContent text.
parsed_structured(c, structured) =
  (k, s) ? byte_length(s) > RESULT_MAX_BYTES -> [limited_result(k), ""] |
  (k, s) -> [{
    resultType: "complete",
    content: [{type: "text", text: s}],
    structuredContent: STRUCT_SLOT_VALUE,
    isError: false,
    "_meta": result_meta(k)
  }, s]

parsed_envelope(ast) = {
  schema_version: "genia.mcp.v1",
  status: "ok",
  result: {kind: "parsed", ast: ast},
  error: nil
}

syntax_error_envelope(offset) =
  error_envelope("parse_error", "parse", parse_error_message(offset))

parse_error_message(offset) =
  o ? is_integer(o) -> concat("Genia source failed to parse at character offset ", display(o)) |
  _ -> "Genia source failed to parse"

# ---- genia_run (E28-3) ----
#
# Execution happens in a disposable host worker; this program validates the request,
# builds the cancellation predicate, maps the worker's closed reply to the envelope,
# and applies the result limit. Every failure message is fixed and server-owned.

call_run(c) =
  k ? parse_arguments_ok(k) == false -> invalid_params(k) |
  k -> result_response(k, run_result(k, field(args_of(k), "source")))

run_result(c, source) =
  (k, src) ? byte_length(src) > SOURCE_MAX_BYTES -> tool_result(k, error_envelope("input_limit", "protocol", "Genia source exceeds the 262144-byte limit")) |
  (k, src) -> run_reply(k, json_decode((map_get(map_get(k, "host"), "run"))(src, cancel_matcher(k))))

keep(f) = f

# Cancellation (contract section 5): the host hands each raw stdin line that arrives
# during the run to this predicate. Only a notification whose requestId is this
# request's id claims it; the host merely multiplexes lines and terminates the worker.
cancel_matcher(c) = keep((line) -> is_cancel_line(json_decode(line), field(msg_of(c), "id")))

is_cancel_line(decoded, id) =
  (some(Json(m), _), i) -> is_cancel_message(m, i) |
  (_, _) -> false

is_cancel_message(m, id) =
  is_object(m) && field(m, "method") == "notifications/cancelled" && present(m, "id") == false && field(field(m, "params"), "requestId") == id

run_reply(c, decoded) =
  (k, some(Json(r), _)) -> run_status(k, field(r, "status"), r) |
  (k, _) -> tool_result(k, run_internal())

run_status(c, status, r) =
  (k, "completed", reply) ? run_completed_ok(reply) -> tool_result(k, run_completed_envelope(reply)) |
  (k, "parse_error", reply) -> tool_result(k, syntax_error_envelope(field(reply, "offset"))) |
  (k, "policy_denied", _) -> tool_result(k, error_envelope("policy_denied", "policy", "source requests a capability unavailable in the MCP v1 profile")) |
  (k, "runtime_error", _) -> tool_result(k, error_envelope("runtime_error", "execution", "Genia source failed during evaluation")) |
  (k, "timeout", _) -> tool_result(k, error_envelope("timeout", "execution", "Execution exceeded the 5000 ms limit")) |
  (k, "cancelled", _) -> tool_result(k, error_envelope("cancelled", "execution", "Execution was cancelled")) |
  (k, "result_limit", _) -> tool_result(k, error_envelope("result_limit", "adapter", "Result exceeds a 1048576-byte channel limit")) |
  (k, _, _) -> tool_result(k, run_internal())

run_internal() = error_envelope("internal_error", "adapter", "Internal error while executing")

run_completed_ok(r) =
  is_string(field(r, "value")) && is_string(field(r, "stdout")) && is_string(field(r, "stderr")) && object_size(r) == 4

run_completed_envelope(r) = {
  schema_version: "genia.mcp.v1",
  status: "ok",
  result: {
    kind: "completed",
    value: {rendered: field(r, "value")},
    stdout: field(r, "stdout"),
    stderr: field(r, "stderr"),
    exit_code: 0
  },
  error: nil
}

list_tools(c) =
  k ? present(params_of(k), "cursor") -> invalid_params(k) |
  k -> result_response(k, list_result(k))

run_method(c) =
  k ? method_of(k) == "server/discover" -> result_response(k, discover_result(k)) |
  k ? method_of(k) == "tools/list" -> list_tools(k) |
  k -> call_tool(k)

check_version(c) =
  k ? field(meta_of(k), META_VERSION) != PROTOCOL_VERSION -> version_error(k, field(meta_of(k), META_VERSION)) |
  k -> run_method(k)

check_meta(c) =
  k ? params_valid(k) == false -> invalid_params(k) |
  k ? meta_valid(k) == false -> invalid_params(k) |
  k -> check_version(k)

modern_dispatch(c) =
  k ? known_method(method_of(k)) == false -> method_not_found(k) |
  k -> check_meta(k)

# ---- the 2025-11-25 era (contract A5.3 - A5.5) ----
# The state is one process-local bit in a ref cell: false (NEW) until a successful
# initialize, then true. Client capabilities and clientInfo are validated for shape
# and discarded; they change no behavior and grant no authority.

initialized(c) = ref_get(map_get(c, "state"))

compat_dispatch(c) =
  k ? method_of(k) == "initialize" -> handle_initialize(k) |
  k ? method_of(k) == "ping" -> handle_ping(k) |
  k ? method_of(k) == "server/discover" -> invalid_params(k) |
  k ? method_of(k) == "tools/list" || method_of(k) == "tools/call" -> compat_tools(k) |
  k -> method_not_found(k)

compat_tools(c) =
  k ? initialized(k) == false -> invalid_params(k) |
  k ? method_of(k) == "tools/list" -> list_tools(k) |
  k -> call_tool(k)

handle_ping(c) =
  k ? present(msg_of(k), "params") && params_valid(k) == false -> invalid_params(k) |
  k -> result_response(k, {})

client_info_of(c) = field(params_of(c), "clientInfo")

client_info_ok(c) = is_string(field(client_info_of(c), "name")) && is_string(field(client_info_of(c), "version"))

initialize_params_ok(c) = is_string(field(params_of(c), "protocolVersion")) && is_object(field(params_of(c), "capabilities")) && client_info_ok(c)

handle_initialize(c) =
  k ? initialized(k) -> invalid_request(k) |
  k ? initialize_params_ok(k) == false -> invalid_params(k) |
  k ? field(params_of(k), "protocolVersion") != COMPAT_PROTOCOL_VERSION -> compat_version_error(k) |
  k -> enter_initialized(k)

enter_initialized(c) =
  ref_set(map_get(c, "state"), true) |> (_) -> result_response(c, initialize_result(c))

initialize_result(c) = {
  protocolVersion: COMPAT_PROTOCOL_VERSION,
  capabilities: {tools: {}},
  serverInfo: server_info(c)
}

compat_version_error(c) =
  with_id(
    {jsonrpc: "2.0",
     error: {code: -32602,
             message: "Unsupported protocol version",
             data: {supported: [COMPAT_PROTOCOL_VERSION],
                    requested: field(params_of(c), "protocolVersion")}}},
    map_get(c, "idv"))

dispatch(c) =
  k ? modern_request(k) -> modern_dispatch(k) |
  k -> compat_dispatch(k)

# A message with a readable id that is a valid JSON-RPC request object.
request_with_id(c) =
  k ? header_valid(msg_of(k)) == false -> invalid_request(k) |
  k -> dispatch(k)

# `boot` is the launch map {rev, host, state}; each request context extends it.
context(boot, msg, idv) = {rev: map_get(boot, "rev"), host: map_get(boot, "host"), state: map_get(boot, "state"), msg: msg, idv: idv}

# A message without id: a notification (no response) when well formed.
notification(c) =
  k ? header_valid(msg_of(k)) -> "" |
  k -> invalid_request(k)

handle_object(c) =
  k ? present(msg_of(k), "id") == false -> notification(k) |
  k ? is_id(field(msg_of(k), "id")) == false -> invalid_request(k) |
  k -> request_with_id(map_put(k, "idv", [field(msg_of(k), "id")]))

handle_value(c) =
  k ? is_object(msg_of(k)) == false -> invalid_request(k) |
  k -> handle_object(k)

handle_decoded(pair) =
  [boot, some(Json(root), _)] -> handle_value(context(boot, norm(root), [])) |
  [boot, _] -> parse_error(context(boot, [], []))

# Outcome-or-response -> optional output line.
to_line(m) =
  "" -> "" |
  x ? present(x, "genia_splice") -> splice_line(field(x, "genia_splice")) |
  x -> frame(x)

# Insert the already-built structuredContent text at its placeholder in the frame.
splice_line(pair) =
  [message, structured] -> splice_frame(split(frame(message), STRUCT_SLOT), structured) |
  _ -> INTERNAL_FRAME

splice_frame(parts, structured) =
  ([before, after], s) -> join(s, [before, after]) |
  (_, _) -> INTERNAL_FRAME

handle_line(boot, line) =
  to_line(handle_decoded([boot, json_decode(line)]))

# ---- program entry ----

nonempty(line) = is_empty(line) == false

# Each response is flushed as soon as it is written: a live client waits on it, and a
# block-buffered pipe would otherwise hold it back until exit (ledger R28-H31).
emit(text) = writeln(stdout, text) |> (_) -> flush(stdout)

serve(rev, host) = serve_lines({rev: rev, host: host, state: ref(false)})

serve_lines(boot) =
  stdin
    |> lines
    |> filter(nonempty)
    |> map((line) -> handle_line(boot, line))
    |> filter(nonempty)
    |> each((text) -> emit(text))
    |> run

hex_revision(s) =
  glob"[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]" -> true |
  _ -> false

# Genia has no process-exit facility (ledger R28-H15): a rejected launch datum
# writes one fixed diagnostic to stderr, then halts through a deliberate runtime
# error (nonzero exit, nothing on stdout). The datum is never echoed.
reject_start() =
  writeln(stderr, "genia-mcp: contract revision must be 40 lowercase hex digits") |>
  (_) -> genia_mcp_launch_rejected

start(args) =
  [rev] ? hex_revision(rev) -> serve(rev, {}) |
  _ -> reject_start()

main(args) = start(args)
