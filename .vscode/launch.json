{
  "version": "0.2.0",
  "configurations": [

    
    {
      "type": "genia",
      "request": "launch",
      "name": "Launch Genia File (${workspaceFolderBasename})",
      "program": "${file}",
      "cwd": "${workspaceFolder}/src",
      
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "genia.interpreter"],
      "stopOnEntry": true
    }
  ]
}