{
  "rules": [
    {
      "action": "DENY",
      "selector": {
        "identifier": "docker-image://*",
        "matchType": "WILDCARD"
      }
    },
    {
      "action": "DENY",
      "selector": {
        "identifier": "http://*",
        "matchType": "WILDCARD"
      }
    },
    {
      "action": "DENY",
      "selector": {
        "identifier": "https://*",
        "matchType": "WILDCARD"
      }
    },
    {
      "action": "DENY",
      "selector": {
        "identifier": "git://*",
        "matchType": "WILDCARD"
      }
    }
  ]
}
