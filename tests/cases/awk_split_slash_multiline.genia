# Multiline awk-style slash-splitting regression case.

@doc "Extract the first slash-separated field from an awk-style input row."
process_line(n, line) =
    (n, [_, $1, .._]) -> nth(0, split($1, "/"))

with_fields(n, line) = process_line(n, fields(line))

awkify(
    with_fields,
    [
        "/a/b/c"
    ]
)
