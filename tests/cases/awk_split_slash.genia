# Awk-style slash-splitting regression case.

@doc "Extract the first slash-separated field from an awk-style input row."
process-line(n, line) =
    (n, [_, $1, .._]) -> nth(0, split($1, "/"))

with_fields(f) = (n, l) -> f(n, fields(l))

awkify(    
    with_fields(process-line),    
    [        "/a/b/c"
])
