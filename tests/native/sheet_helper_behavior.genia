@test "sheet shape columns and rows are deterministic"
sheet_shape_columns_and_rows_are_deterministic() = {
  people = sheet([
    [quote(name), ["Ann", "Bob", "Cara"]],
    [quote(age), [30, 22, 41]]
  ])

  assert_eq(shape(people), [[quote(rows), 3], [quote(columns), 2]])
  assert_eq(columns(people), [quote(name), quote(age)])
  assert_eq(rows(people), [
    [[quote(name), "Ann"], [quote(age), 30]],
    [[quote(name), "Bob"], [quote(age), 22]],
    [[quote(name), "Cara"], [quote(age), 41]]
  ])
}

@test "empty sheet has zero shape columns and rows"
empty_sheet_has_zero_shape_columns_and_rows() = {
  empty = sheet([])
  selected = empty |> select([])

  assert_eq(shape(empty), [[quote(rows), 0], [quote(columns), 0]])
  assert_eq(columns(empty), [])
  assert_eq(rows(empty), [])
  assert_eq(shape(selected), [[quote(rows), 0], [quote(columns), 0]])
}

@test "sheet select reorders columns and preserves original"
sheet_select_reorders_columns_and_preserves_original() = {
  people = sheet([
    [quote(name), ["Ann", "Bob"]],
    [quote(age), [30, 22]],
    [quote(city), ["Provo", "Ogden"]]
  ])
  selected = people |> select([quote(age), quote(name)])

  assert_eq(columns(selected), [quote(age), quote(name)])
  assert_eq(rows(selected), [
    [[quote(age), 30], [quote(name), "Ann"]],
    [[quote(age), 22], [quote(name), "Bob"]]
  ])
  assert_eq(shape(people), [[quote(rows), 2], [quote(columns), 3]])
}

@test "sheet where filters rows and preserves original"
sheet_where_filters_rows_and_preserves_original() = {
  people = sheet([
    [quote(name), ["Ann", "Bob"]],
    [quote(age), [30, 22]]
  ])
  kept = people |> where((row) -> true)
  dropped = people |> where((row) -> false)

  assert_eq(rows(kept), [
    [[quote(name), "Ann"], [quote(age), 30]],
    [[quote(name), "Bob"], [quote(age), 22]]
  ])
  assert_eq(shape(dropped), [[quote(rows), 0], [quote(columns), 2]])
  assert_eq(shape(people), [[quote(rows), 2], [quote(columns), 2]])
}

@test "sheet derive appends outcome cells and preserves original"
sheet_derive_appends_outcome_cells_and_preserves_original() = {
  people = sheet([
    [quote(name), ["Ann", "Bob"]],
    [quote(age), [30, 22]]
  ])
  derived = people |> derive(quote(status), (row) -> some("ok"))

  assert_eq(rows(derived), [
    [[quote(name), "Ann"], [quote(age), 30], [quote(status), some("ok")]],
    [[quote(name), "Bob"], [quote(age), 22], [quote(status), some("ok")]]
  ])
  assert_eq(shape(people), [[quote(rows), 2], [quote(columns), 2]])
}

@test "row_get returns a named cell directly and inside where/derive"
row_get_returns_named_cell_directly_and_inside_where_derive() = {
  people = sheet([
    [quote(name), ["Ann", "Bob", "Cara"]],
    [quote(age), [30, 22, 41]]
  ])
  older = people
    |> where((row) -> row_get(row, quote(age)) >= 30)
    |> derive(quote(age_next), (row) -> row_get(row, quote(age)) + 1)

  assert_eq(row_get([[quote(age), 30]], quote(age)), 30)
  assert_eq(rows(older), [
    [[quote(name), "Ann"], [quote(age), 30], [quote(age_next), 31]],
    [[quote(name), "Cara"], [quote(age), 41], [quote(age_next), 42]]
  ])
}

@test "collect_sheet builds an immutable Sheet from homogeneous map records"
collect_sheet_builds_sheet_from_homogeneous_records() = {
  empty = collect_sheet([])
  assert_eq(shape(empty), [[quote(rows), 0], [quote(columns), 0]])

  report = collect_sheet([
    {name: "Ann", age: 30},
    {age: 22, name: "Bob"}
  ])

  assert_eq(shape(report), [[quote(rows), 2], [quote(columns), 2]])
  assert_eq(columns(report), ["name", "age"])
  assert_eq(rows(report), [
    [["name", "Ann"], ["age", 30]],
    [["name", "Bob"], ["age", 22]]
  ])
}

@test "render_csv produces deterministic escaped report text"
render_csv_produces_deterministic_escaped_report_text() = {
  report = sheet([
    [quote(name), ["Ann", "Bob"]],
    [quote(note), ["hello, world", "said \"hi\""]]
  ])

  assert_eq(
    render_csv(report),
    "name,note\nAnn,\"hello, world\"\nBob,\"said \"\"hi\"\"\"\n"
  )
}
