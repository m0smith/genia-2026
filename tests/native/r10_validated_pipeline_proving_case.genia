pattern R10Port(value) = refinement_match((number) -> number > 0 && number <= 65535, value)

r10_valid_record(record) =
  validate_record(record, {
    id: (value) -> validate_required("id", value),
    name: (value) -> validate_required("name", value)
  })

test("R10 configuration and protected values compose with validated records", () -> {
  provider = config_provider([{
    kind: quote(values),
    values: {PORT: "8080", TOKEN: "native-fixture"}
  }]) |> unwrap_or(none)
  port = config_get(provider, "PORT") |> parse_int |> R10Port
  token = secret_get(provider, "TOKEN", quote(native_outbound)) |> unwrap_or(none)
  result =
    [some({id: 1, name: "Ada"}), none("blank_line"), {id: 2}]
      |> ((records) -> validate_each(records, r10_valid_record))
      |> collect_validated

  assert_eq(display(port), "some(8080)")
  assert_eq(display(result("clean")), "[{id: 1, name: Ada}]")
  assert_eq(count(result("diagnostics")), 2)
  assert_eq(display(token), "<protected>")
  assert_eq(protected_match("secret", token) |> some?, true)
})
