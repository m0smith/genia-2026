{
  "pipeline_none_short_circuit": "`none(...)` short-circuits the remaining pipeline stages.",
  "pipeline_some_lifts": "ordinary stages lift over `some(x)` automatically.",
  "pipeline_wrap_back": "lifted non-Option results are wrapped back into `some(...)`.",
  "pipeline_option_results_preserved": "Option results are preserved as-is.",
  "direct_call_option_behavior": "In direct calls, `some(x)` is still a normal value and is passed explicitly.",
  "pipe_wrapper": "runs the stage expression over `stdin |> lines`, then consumes the final Flow automatically",
  "stdin_bridge_only": "`stdin` is a host-backed input capability, not a direct Seq-compatible public value; adapt it with `stdin |> lines` before using Flow/Seq terminals.",
  "main_dispatch": "call `main(argv())` when `main/1` exists, otherwise call `main()` when `main/0` exists",
  "pipe_bypasses_main": "pipe mode bypasses `main`",
  "flow_single_use": "Flow values are lazy, pull-based, source-bound, and single-use.",
  "flow_early_termination": "`head` / `take` stop upstream pulling promptly.",
  "host_status": "Python is the full-language reference host; C++ is the bounded R27 production host with Ref, Cell, local Process, a scripted REPL, Bytes/UTF-8 plus strict JSON data bridges, Flow phase 1, and pipe mode.",
  "naming_rule": "new `?`-suffixed APIs are boolean-returning; `get?` remains the current compatibility exception.",
  "annotation_builtins": "`@doc`, `@meta`, `@since`, `@deprecated`, `@category`, inert Experimental `@route`, inert Experimental `@server`, and inert Experimental `@cors`",
  "canonical_format_field_path_separator": "Dot (`.`) is the canonical field-path separator for representation/format placeholders; slash (`/`) is not the format field-path separator and remains limited to existing slash operator/Core IR wording.",
  "canonical_named_access_separator": "Dot (`.`) is the canonical named-access separator; legacy slash named access has been removed and is not general field-path lookup.",
  "native_test_annotation_discovery": "`@test \"description\"` annotates zero-argument functions for native test discovery; discovery runs after legacy `test(name, body)` registrations; duplicate native-test names across explicit and annotated tests are discovery errors.",
  "native_test_metadata_string_boundary": "Native test metadata keys and values must be strings. Non-string metadata keys or values are reported as deterministic discovery errors before test body execution. Diagnostics use Genia runtime type names and append existing TestUnit.location when available.",
  "r11_ordinary_composition_boundary": "R11 messages and requests are ordinary values, prompts are functions, models are callable, chains are pipelines, and conversations are application-owned composition over existing scan; provider adapters are Python-host-only.",
  "r12_ordinary_composition_boundary": "R12 documents, chunks, embeddings, evidence, grounded contexts, and grounded answers are ordinary values composed through callables and Outcomes; exact provenance, explicit query embedding, an opaque index handle, backend-native scores, and unchanged model/4 remain distinct, while provider fixtures and private handle mechanics are Python-host-only.",
  "r13_ordinary_composition_boundary": "R13 configuration views are ordinary callables over an explicit provider; Outcomes, immutable snapshots, explicit conversion and callable Template validation, and protected values compose without ambient lookup, while environment and exact-path file acquisition are Python-host-only.",
  "r18_equality_relation": "Genia has one non-overloadable semantic equality relation; == , != , literal patterns, duplicate bindings, assert_eq, map-key identity, and Sheet column-name identity all answer identically, protected equality observes carrier identity only, and map iteration order remains a separate observable from map equality.",
