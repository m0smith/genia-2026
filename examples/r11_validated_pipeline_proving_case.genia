"""
# R11 Outcome-Aware Validated Pipeline Proving Case

Composes messy JSONL records, existing validation, an ordinary structured model
stage, R9 JSON/Templates, R10 protected credentials, and collected diagnostics.

## Run

```bash
uv run python -m hosts.python.exec_model_fixture --file examples/r11_validated_pipeline_proving_case.genia
```

## Features Demonstrated

* JSONL parsing and Outcome-aware record validation
* explicit ordinary model configuration
* explicitly injected protected credential and provider capabilities
* R9 JSON schema and callable Template structured output
* ordinary model call as a pipeline stage
* clean values and useful diagnostics through `collect_validated`
"""

pipeline_config = config_provider([{
  kind: quote(values),
  values: {
    MODEL_ID: "fixture-r11-pipeline",
    TIMEOUT_MS: "1000"
  }
}]) |> unwrap_or(none)

model_id = config_get(pipeline_config, "MODEL_ID") |> unwrap_or("")
timeout_ms = config_get(pipeline_config, "TIMEOUT_MS") |> parse_int |> unwrap_or(0)

output_schema = json_decode("""
{
  "type": "object",
  "properties": {
    "id": {"type": "integer"},
    "label": {"type": "string"}
  },
  "required": ["id", "label"],
  "additionalProperties": false
}
""") |> unwrap_or({})

OutputRecord = json_schema(output_schema) |> unwrap_or((_) -> none("schema-compile-failed"))

pipeline_model = model(
  model_provider_fixture,
  {id: model_id, timeout_ms: timeout_ms},
  model_credential_fixture,
  model_authority_fixture
)

@doc "Validate the required fields of one parsed input record."
validate_input_record(record) =
  validate_record(record, {
    id: (value) -> validate_required("id", value),
    name: (value) -> validate_required("name", value)
  })

@doc "Build one closed structured model request from a validated record."
prompt(record) = {
  messages: [{
    role: quote(user),
    content: {kind: quote(text), text: concat("enrich record ", display(record))}
  }],
  output: {kind: quote(json), schema: output_schema, template: OutputRecord}
}

process_validated_record(value, original_outcome) =
  (some(record), _) -> apply_raw(pipeline_model, [prompt(record)]) |> "message" |> "content" |> "value" |
  (none(_), original_outcome) -> original_outcome |
  (none(_, _), original_outcome) -> original_outcome |
  (err(_), original_outcome) -> original_outcome |
  (err(_, _), original_outcome) -> original_outcome

@doc "Parse, validate, and enrich one JSONL line as an Outcome."
process_line(line) = {
  parsed_and_validated = parse_jsonl_record(line) |> validate_input_record
  apply_raw(process_validated_record, [parsed_and_validated, parsed_and_validated])
}

@doc "Collect clean structured results and diagnostics from JSONL lines."
run_validated_model_pipeline(lines) =
  lines
    |> ((items) -> validate_each(items, process_line))
    |> collect_validated

proving_lines = [
  "{\"id\":1,\"name\":\"Ada\"}",
  "",
  "not-json",
  "{\"id\":9}",
  "{\"id\":2,\"name\":\"Grace\"}"
]

collected = run_validated_model_pipeline(proving_lines)

{
  clean: collected("clean"),
  diagnostics: collected("diagnostics")
}
