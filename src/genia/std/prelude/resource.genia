@doc """Construct a ResourceRef map for a filesystem path.

## Arguments
- `path`: filesystem path string

## Returns
- `{uri: path, backend: "fs"}`
"""
resource_ref(path) = {uri: path, backend: "fs"}

@doc """Discover all files under `root` as a lazy Flow of ResourceRef maps.

## Arguments
- `root`: filesystem ResourceRef for a directory

## Returns
- lazy Flow of `{uri: string, backend: "fs"}` file refs
- `none("resource-not-found", context)` if `root` does not exist
- `none("resource-malformed-ref", context)` if `root` is not a valid ResourceRef
- `none("resource-unsupported", context)` for an unsupported backend

## Notes
- directories are not emitted
"""
discover(root) = _resource_discover(root)

@doc """Read file at `ref` as UTF-8 text.

## Arguments
- `ref`: ResourceRef for a file

## Returns
- file content as a string on success
- `none("resource-not-found", context)` if the file does not exist
- `none("resource-read-error", context)` on other IO failures
- `none("resource-malformed-ref", context)` if `ref` is not a valid ResourceRef
- `none("resource-unsupported", context)` if the backend is not supported
"""
read_text(ref) = _resource_read_text(ref)

@doc """Read file at `ref` as raw bytes.

## Arguments
- `ref`: ResourceRef for a file

## Returns
- bytes value on success
- `none("resource-not-found", context)` if the file does not exist
- `none("resource-read-error", context)` on other IO failures
- `none("resource-malformed-ref", context)` if `ref` is not a valid ResourceRef
- `none("resource-unsupported", context)` if the backend is not supported
"""
read_bytes(ref) = _resource_read_bytes(ref)

@doc """Write UTF-8 `text` to file at `ref`.

## Arguments
- `ref`: ResourceRef for the destination file
- `text`: ordinary UTF-8 string content

## Returns
- `ref` on success
- `none("resource-write-error", context)` on an invalid text value or IO failure
- `none("resource-malformed-ref", context)` if `ref` is not a valid ResourceRef
- `none("resource-unsupported", context)` if the backend is not supported
- `none("protected-value", context)` or `none("authority-value", context)` when protected sink rules reject the inputs
"""
write_text(ref, text) = _resource_write_text(ref, text)

@doc """Write raw `bytes` to file at `ref`.

## Arguments
- `ref`: ResourceRef for the destination file
- `bytes`: opaque bytes value

## Returns
- `ref` on success
- `none("resource-write-error", context)` on an invalid bytes value or IO failure
- `none("resource-malformed-ref", context)` if `ref` is not a valid ResourceRef
- `none("resource-unsupported", context)` if the backend is not supported
- `none("protected-value", context)` or `none("authority-value", context)` when protected sink rules reject the inputs
"""
write_bytes(ref, bytes) = _resource_write_bytes(ref, bytes)

@doc """Delete the file at `ref`.

## Arguments
- `ref`: ResourceRef for the file

## Returns
- `none("nil")` when the file is deleted or already absent
- `none("resource-delete-error", context)` on failure
- `none("resource-malformed-ref", context)` if `ref` is not a valid ResourceRef
- `none("resource-unsupported", context)` if the backend is not supported
"""
delete(ref) = _resource_delete(ref)

@doc """Copy the file from `from_ref` to `to_ref`.

## Arguments
- `from_ref`: source file ResourceRef
- `to_ref`: destination file ResourceRef

## Returns
- `to_ref` on success
- `none("resource-not-found", context)` if the source does not exist
- `none("resource-copy-error", context)` on other failures
- `none("resource-malformed-ref", context)` if either ref is not a valid ResourceRef
- `none("resource-unsupported", context)` if either backend is not supported
"""
copy(from_ref, to_ref) = _resource_copy(from_ref, to_ref)

@doc """Return metadata for the resource at `ref`.

## Arguments
- `ref`: ResourceRef to inspect

## Returns
- map with `exists`, `backend`, and `size` when the file exists
- `none("resource-meta-error", context)` on failure
- `none("resource-malformed-ref", context)` if `ref` is not a valid ResourceRef
- `none("resource-unsupported", context)` if the backend is not supported
"""
resource_meta(ref) = _resource_meta(ref)

@doc """Return the capability map for the resource IO host.

## Returns
- fixed map with `backends`, `supports_discover`, `supports_delete`, `supports_copy`, `supports_meta`, and `supports_bytes`
"""
resource_capabilities() = _resource_capabilities()
