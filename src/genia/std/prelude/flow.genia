@doc """Create a Flow from `stdin`, an incoming Flow, or a list of strings.

## Arguments
- `source`: `stdin`, an existing Flow, or a list of strings to read lines from

## Returns
- a Flow of the source lines

## Notes
- the Flow is lazy and pull-based, consumed once as items are demanded
"""
@category "flow"
lines(source) = _lines(source)

@doc """Create a Flow by repeatedly applying `step` to the previous value.

The first emitted item is `init`; each later item is `step(previous_value)`.

## Arguments
- `init`: the first item emitted by the Flow
- `step`: function mapping the previous value to the next value

## Returns
- a lazy Flow of successive values starting at `init`

## Notes
- the Flow is unbounded; bound it with `take`/`head`
- lazy and pull-based, computing one step at a time as items are demanded
"""
@category "flow"
evolve(init, step) = _evolve(init, step)

@doc """Split one input flow into two lazy branch flows.

## Arguments
- `flow`: the source Flow to split

## Returns
- a pair of two lazy branch Flows over the same source items

## Notes
- the source Flow is consumed once, buffered only as needed when one branch lags behind the other
- both branches are lazy and pull-based
"""
@category "flow"
tee(flow) = _tee(flow)

@doc """Concatenate two flows into one output flow.

`merge(flow1, flow2)` emits items from `flow1` first, then `flow2`.
`merge(pair)` unpacks a `[flow1, flow2]` pair, e.g. from `tee`.

## Arguments
- `flow1`: Flow whose items are emitted first
- `flow2`: Flow whose items are emitted after `flow1` is exhausted
- `pair`: a `[flow1, flow2]` pair, as an alternative to passing the two flows separately

## Returns
- a lazy Flow emitting all of `flow1` followed by all of `flow2`

## Notes
- lazy and pull-based; `flow2` is not consumed until `flow1` is exhausted
"""
@category "flow"
merge(flow1, flow2) = _merge(flow1, flow2)

@doc """Concatenate two flows into one output flow.

`merge(flow1, flow2)` emits items from `flow1` first, then `flow2`.
`merge(pair)` unpacks a `[flow1, flow2]` pair, e.g. from `tee`.

## Arguments
- `flow1`: Flow whose items are emitted first
- `flow2`: Flow whose items are emitted after `flow1` is exhausted
- `pair`: a `[flow1, flow2]` pair, as an alternative to passing the two flows separately

## Returns
- a lazy Flow emitting all of `flow1` followed by all of `flow2`

## Notes
- lazy and pull-based; `flow2` is not consumed until `flow1` is exhausted
"""
@category "flow"
merge(pair) = _merge(pair)

@doc """Combine two flows into a flow of pairs.

`zip(flow1, flow2)` pairs items from both flows at each step.
`zip(pair)` unpacks a `[flow1, flow2]` pair, e.g. from `tee`.

## Arguments
- `flow1`: Flow supplying the left element of each pair
- `flow2`: Flow supplying the right element of each pair
- `pair`: a `[flow1, flow2]` pair, as an alternative to passing the two flows separately

## Returns
- a lazy Flow whose items are `[left, right]`, preserving lockstep order

## Notes
- output stops as soon as either input Flow is exhausted
- lazy and pull-based
"""
@category "flow"
zip(flow1, flow2) = _zip(flow1, flow2)

@doc """Combine two flows into a flow of pairs.

`zip(flow1, flow2)` pairs items from both flows at each step.
`zip(pair)` unpacks a `[flow1, flow2]` pair, e.g. from `tee`.

## Arguments
- `flow1`: Flow supplying the left element of each pair
- `flow2`: Flow supplying the right element of each pair
- `pair`: a `[flow1, flow2]` pair, as an alternative to passing the two flows separately

## Returns
- a lazy Flow whose items are `[left, right]`, preserving lockstep order

## Notes
- output stops as soon as either input Flow is exhausted
- lazy and pull-based
"""
@category "flow"
zip(pair) = _zip(pair)

@doc """Explicitly adapt a list or string into a Seq-compatible ordered source.

## Arguments
- `value`: a list or string to adapt

## Returns
- an ordered, Seq-compatible source over `value`

## Notes
- lists are yielded as ordered elements without flattening
- strings are decomposed into one-character strings only through this helper
"""
@category "flow"
as_seq(value) = _as_seq(value)

@doc """Stateful flow transform driven by `step`.

`step(state, item)` must return `[next_state, output]`.
Use this for running totals, buffering, and fixed-size windowing.

## Arguments
- `step`: function receiving the current state and an item, returning `[next_state, output]`
- `initial_state`: the state passed to `step` for the first item
- `flow`: the input Flow (omit to get a reusable stage)

## Returns
- with `flow`: a lazy Flow of the `output` values produced by `step`
- without `flow`: a stage `(flow) -> flow` that applies the transform when given a Flow

## Notes
- `next_state` stays internal to this operator and is not exposed externally
- lazy and pull-based
"""
@category "flow"
scan(step, initial_state) = (flow) -> _scan(step, initial_state, flow)

@doc """Stateful flow transform driven by `step`.

`step(state, item)` must return `[next_state, output]`.
Use this for running totals, buffering, and fixed-size windowing.

## Arguments
- `step`: function receiving the current state and an item, returning `[next_state, output]`
- `initial_state`: the state passed to `step` for the first item
- `flow`: the input Flow (omit to get a reusable stage)

## Returns
- with `flow`: a lazy Flow of the `output` values produced by `step`
- without `flow`: a stage `(flow) -> flow` that applies the transform when given a Flow

## Notes
- `next_state` stays internal to this operator and is not exposed externally
- lazy and pull-based
"""
@category "flow"
scan(step, initial_state, flow) = _scan(step, initial_state, flow)

@doc """Keep only successful Option values from a flow.

`keep_some(flow)` filters a Flow that already holds Option items.
`keep_some(stage, flow)` applies an Option-returning `stage` to each item inline.

## Arguments
- `stage`: optional Option-returning function applied to each item before filtering
- `flow`: the input Flow

## Returns
- a lazy Flow of the values inside each `some(value)`

## Notes
- `some(value)` is unwrapped to `value`; `none(...)` items are dropped
- equivalent to `keep_some_else(stage, (_) -> nil, flow)`
- lazy and pull-based
"""
@category "flow"
keep_some(flow) = _keep_some(flow)

@doc """Keep only successful Option values from a flow.

`keep_some(flow)` filters a Flow that already holds Option items.
`keep_some(stage, flow)` applies an Option-returning `stage` to each item inline.

## Arguments
- `stage`: optional Option-returning function applied to each item before filtering
- `flow`: the input Flow

## Returns
- a lazy Flow of the values inside each `some(value)`

## Notes
- `some(value)` is unwrapped to `value`; `none(...)` items are dropped
- equivalent to `keep_some_else(stage, (_) -> nil, flow)`
- lazy and pull-based
"""
@category "flow"
keep_some(stage, flow) = _keep_some_else(stage, (_) -> nil, flow)

@doc """Apply an Option-returning `stage` to each flow item, routing failures to `dead_handler`.

## Arguments
- `stage`: Option-returning function; it receives the original raw flow item
- `dead_handler`: called with the original item whenever `stage` returns `none(...)`
- `flow`: the input Flow (omit to get a reusable stage)

## Returns
- with `flow`: a lazy Flow of the values from each `some(value)`
- without `flow`: a stage `(flow) -> flow`

## Notes
- `some(value)` continues on the main Flow as `value`; `none(...)` drops the item and invokes `dead_handler`
- explicit dead-letter routing; it does not change ordinary `|>` semantics outside this helper
- lazy and pull-based
"""
@category "flow"
keep_some_else(stage, dead_handler) = (flow) -> _keep_some_else(stage, dead_handler, flow)

@doc """Apply an Option-returning `stage` to each flow item, routing failures to `dead_handler`.

## Arguments
- `stage`: Option-returning function; it receives the original raw flow item
- `dead_handler`: called with the original item whenever `stage` returns `none(...)`
- `flow`: the input Flow (omit to get a reusable stage)

## Returns
- with `flow`: a lazy Flow of the values from each `some(value)`
- without `flow`: a stage `(flow) -> flow`

## Notes
- `some(value)` continues on the main Flow as `value`; `none(...)` drops the item and invokes `dead_handler`
- explicit dead-letter routing; it does not change ordinary `|>` semantics outside this helper
- lazy and pull-based
"""
@category "flow"
keep_some_else(stage, dead_handler, flow) = _keep_some_else(stage, dead_handler, flow)


@doc """Apply rule functions left-to-right to each incoming flow item.

## Arguments
- `fns`: variadic rule functions, applied in order to each item; a Flow may be passed as the final argument to run immediately

## Returns
- a Flow stage `(flow) -> flow`, or the transformed Flow when a Flow is supplied as the last argument

## Notes
- rule orchestration, defaulting, and contract validation live in the prelude in this phase
- legacy/compatibility name; prefer `refine`
- lazy and pull-based
"""
@category "flow"
rules(..fns) = rules_dispatch(fns)

@doc """Apply step functions left-to-right to each incoming flow item.

## Arguments
- `steps`: variadic step functions, applied in order to each item; a Flow may be passed as the final argument to run immediately

## Returns
- a Flow stage `(flow) -> flow`, or the transformed Flow when a Flow is supplied as the last argument

## Notes
- preferred alias for `rules(..steps)`; see also `rules` (compatibility)
- lazy and pull-based
"""
@category "flow"
refine(..steps) = rules(..steps)

@doc "Return `none` for a `rules(..fns)` rule with no effect.\nLegacy/compatibility name; see also `step_skip` (preferred)."
@category "flow"
rule_skip() = none

@doc "Emit one output value from a `rules(..fns)` rule.\nLegacy/compatibility name; see also `step_emit` (preferred)."
@category "flow"
rule_emit(x) = some({ emit: [x] })

@doc "Emit a list of output values from a `rules(..fns)` rule.\nLegacy/compatibility name; see also `step_emit_many` (preferred)."
@category "flow"
rule_emit_many(xs) = some({ emit: xs })

@doc "Replace the current record for later `rules(..fns)` rules on the same input item.\nLegacy/compatibility name; see also `step_set` (preferred)."
@category "flow"
rule_set(record) = some({ record: record })

@doc "Replace the running `ctx` for later `rules(..fns)` rules and later input items.\nLegacy/compatibility name; see also `step_ctx` (preferred)."
@category "flow"
rule_ctx(ctx) = some({ ctx: ctx })

@doc "Stop later `rules(..fns)` rules for the current input item.\nLegacy/compatibility name; see also `step_halt` (preferred)."
@category "flow"
rule_halt() = some({ halt: true })

@doc "Replace `record`, replace `ctx`, and emit `out` in one `rules(..fns)` step.\nLegacy/compatibility name; see also `step_step` (preferred)."
@category "flow"
rule_step(record, ctx, out) = some({ record: record, ctx: ctx, emit: out })

@doc "Return `none` for a `refine(..steps)` step with no effect.\nPreferred alias for `rule_skip()`."
@category "flow"
step_skip() = rule_skip()

@doc "Emit one output value from a `refine(..steps)` step.\nPreferred alias for `rule_emit(x)`."
@category "flow"
step_emit(x) = rule_emit(x)

@doc "Emit a list of output values from a `refine(..steps)` step.\nPreferred alias for `rule_emit_many(xs)`."
@category "flow"
step_emit_many(xs) = rule_emit_many(xs)

@doc "Replace the current record for later `refine(..steps)` steps on the same input item.\nPreferred alias for `rule_set(record)`."
@category "flow"
step_set(record) = rule_set(record)

@doc "Replace the running `ctx` for later `refine(..steps)` steps and later input items.\nPreferred alias for `rule_ctx(ctx)`."
@category "flow"
step_ctx(ctx) = rule_ctx(ctx)

@doc "Stop later `refine(..steps)` steps for the current input item.\nPreferred alias for `rule_halt()`."
@category "flow"
step_halt() = rule_halt()

@doc "Replace `record`, replace `ctx`, and emit `out` in one `refine(..steps)` step.\nPreferred alias for `rule_step(record, ctx, out)`."
@category "flow"
step_step(record, ctx, out) = rule_step(record, ctx, out)

rules_dispatch(args) =
  (args) ? rules_immediate_flow?(args) == true -> {
    flow = rules_last_arg(args)
    fns = rules_drop_last(args)
    rules_stage(_rules_prepare(fns))(flow)
  } |
  (args) -> rules_stage(_rules_prepare(args))

rules_immediate_flow?(args) =
  ([]) -> false |
  (args) -> _flow?(rules_last_arg(args))

rules_last_arg(args) = unwrap_or(nil, last(args))
rules_drop_last(args) = take(count(args) - 1, args)

rules_stage(fns) =
  ([]) -> (flow) -> flow |
  (fns) -> (flow) -> _rules_kernel((record, ctx) -> rules_apply(fns, record, ctx, [], 1), flow)

rules_apply(fns, record, ctx, out, rule_index) =
  ([], _, ctx, out, _) -> { emit: out, ctx: ctx } |
  ([rule, ..rest], record, ctx, out, rule_index) -> rules_apply_result(
    apply(rule, [record, ctx]),
    rest,
    record,
    ctx,
    out,
    rule_index
  )

rules_apply_result(result, rest, record, ctx, out, rule_index) =
  (none, rest, record, ctx, out, rule_index) -> rules_apply(
    rest,
    record,
    ctx,
    out,
    rule_index + 1
  ) |
  (some(result_map), rest, record, ctx, out, rule_index) -> rules_apply_some(
    result_map,
    rest,
    record,
    ctx,
    out,
    rule_index
  ) |
  (result, _, _, _, _, rule_index) -> _rules_error(
    rule_index,
    concat("returned ", concat(_flow_debug(result), "; expected none(...) or some(result)"))
  )

rules_apply_some(result_map, rest, record, ctx, out, rule_index) =
  (result_map, rest, record, ctx, out, rule_index) ? rules_map?(result_map) == true -> {
    next_record = rules_result_record(result_map, record)
    next_ctx = rules_result_ctx(result_map, ctx)
    emitted = rules_result_emit(result_map, rule_index)
    halted = rules_result_halt(result_map, rule_index)
    rules_apply_next(rest, next_record, next_ctx, [..out, ..emitted], halted, rule_index)
  } |
  (result_map, _, _, _, _, rule_index) -> _rules_error(
    rule_index,
    concat("returned some(result) with ", concat(_flow_debug(result_map), "; expected a map"))
  )

rules_apply_next(rest, record, ctx, out, halt, rule_index) =
  (_, _, ctx, out, true, _) -> { emit: out, ctx: ctx } |
  (rest, record, ctx, out, false, rule_index) -> rules_apply(
    rest,
    record,
    ctx,
    out,
    rule_index + 1
  )

rules_result_emit(result_map, rule_index) =
  rules_result_emit_value(get("emit", result_map), rule_index)

rules_result_emit_value(found, rule_index) =
  (none, _) -> [] |
  (some(emit), _) ? rules_list?(emit) == true -> emit |
  (some(emit), rule_index) -> _rules_error(
    rule_index,
    concat("returned emit = ", concat(_flow_debug(emit), "; expected a list"))
  )

rules_result_record(result_map, default) =
  rules_optional_value(result_map, "record", default)

rules_result_ctx(result_map, default) =
  rules_optional_value(result_map, "ctx", default)

rules_optional_value(result_map, key, default) =
  (none, key, default) -> default |
  (result_map, key, default) -> get_or(key, result_map, default)

rules_result_halt(result_map, rule_index) =
  rules_result_halt_value(get("halt", result_map), rule_index)

rules_result_halt_value(found, rule_index) =
  (none, _) -> false |
  (some(true), _) -> true |
  (some(false), _) -> false |
  (some(halt), rule_index) -> _rules_error(
    rule_index,
    concat("returned halt = ", concat(_flow_debug(halt), "; expected a boolean"))
  )

map?(v) =
  ({}) -> true |
  (none) -> false |
  (_) -> false

list?(v) =
  ([]) -> true |
  ([_, .._]) -> true |
  (none) -> false |
  (_) -> false

get_or(key, target, default) =
  unwrap_or(default, get(key, target))

rules_map?(value) =
  (none) -> false |
  (v) -> map?(v)

rules_list?(value) =
  (none) -> false |
  (v) -> list?(v)

@doc """Run `fn` for each item of a list or Flow, passing the original items through.

## Arguments
- `fn`: function invoked for each item, for its side effects
- `source`: a list or Flow to traverse

## Returns
- a lazy Flow stage that yields the original items unchanged when consumed

## Notes
- `fn` runs for an item only when that item is consumed downstream
- lazy and pull-based
"""
@category "flow"
each(fn, source) = _each(fn, source)

@doc """Return list data from a list or by materializing a Flow.

## Arguments
- `source`: a list or Flow to materialize

## Returns
- a list containing every item of `source`

## Notes
- materializing a Flow consumes it to completion; a Flow is single-use
"""
@category "flow"
collect(source) = _collect(source)

@doc """Consume or traverse a list or Flow to completion and return nil.

## Arguments
- `source`: a list or Flow to run for its effects

## Returns
- nil

## Notes
- consumes a Flow to completion; a Flow is single-use
"""
@category "flow"
run(source) = _run(source)
